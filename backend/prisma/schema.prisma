generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Model User 
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(SALES)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  assignedCustomers Customer[]     @relation("CustomerAssignment")
  callLogs          CallLog[]      @relation("UserCallLogs")
  refreshTokens     RefreshToken[] @relation("UserRefreshTokens")

  @@index([role])
  @@index([email, role]) // Composite index for auth queries
  @@map("users")
}

// Model Refresh Token
model RefreshToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  userId    Int       @map("user_id")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent") @db.Text
  ipAddress String?   @map("ip_address")

  // Relations
  user User @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([userId, expiresAt]) // Composite for active tokens query
  @@index([token, revokedAt]) // Composite for token validation
  @@map("refresh_tokens")
}

enum Role {
  ADMIN // Bisa membuat akun dan full access
  SALES_MANAGER // Baca performa sales dan manage data customer
  SALES // Hanya akses customer yang diassign
}

model Customer {
  id         Int @id @default(autoincrement())
  originalId Int @unique @map("originalId") // ID dari CSV (row number)

  // Assignment ke sales
  salesId    Int?  @map("sales_id")
  assignedTo User? @relation("CustomerAssignment", fields: [salesId], references: [id])

  // Kolom dari nasabah_prioritas.csv 
  name        String?
  phoneNumber String? @map("phoneNumber")
  score       Float?

  // Kolom dari bank-additional-full.csv 
  age          Int
  job          String
  marital      String
  education    String
  default      String
  housing      String
  loan         String
  contact      String
  month        String
  dayOfWeek    String @map("day_of_week")
  duration     Int
  campaign     Int
  pdays        Int
  previous     Int
  poutcome     String
  empVarRate   Float  @map("emp.var.rate")
  consPriceIdx Float  @map("cons.price.idx")
  consConfIdx  Float  @map("cons.conf.idx")
  euribor3m    Float
  nrEmployed   Float  @map("nr.employed")

  // AI Generated Guide Cache
  conversationGuide Json? @map("conversation_guide")

  // Relations
  callLogs CallLog[] @relation("CustomerCallLogs")

  // Indexes for common queries
  @@index([salesId])
  @@index([name])
  @@index([phoneNumber])
  @@index([score])
  @@index([salesId, score]) // Composite for sales assignment + score filtering
  @@index([job]) // For job filtering
  @@index([marital]) // For marital status filtering
  @@index([education]) // For education filtering
  @@index([age, score]) // Composite for demographic queries
  @@map("customers")
}

// Model untuk Call Log
model CallLog {
  id         Int        @id @default(autoincrement())
  customerId Int        @map("customer_id")
  userId     Int        @map("user_id")
  status     CallStatus
  notes      String?    @db.Text
  callDate   DateTime   @default(now()) @map("call_date")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  // Relations
  customer Customer @relation("CustomerCallLogs", fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation("UserCallLogs", fields: [userId], references: [id], onDelete: Restrict)

  // Indexes for common queries
  @@index([customerId])
  @@index([userId])
  @@index([status])
  @@index([callDate])
  @@index([customerId, callDate]) // Composite for customer call history
  @@index([userId, callDate]) // Composite for user activity tracking
  @@index([status, callDate]) // Composite for status reports
  @@map("call_logs")
}

enum CallStatus {
  TERTARIK
  TIDAK_TERTARIK
  TIDAK_TERSEDIA
  SALAH_NOMOR
  BERMINAT
}
