# Environment Variables untuk Banking Portal Backend
# Copy file ini menjadi .env dan isi dengan nilai yang sesuai

# Server Configuration
PORT=8000
NODE_ENV=development

# Database Connection
DATABASE_URL="postgresql://user:password@localhost:5433/portal_banking?connection_limit=10&pool_timeout=20"

# Redis Cache (Optional - application will work without it)
# If not provided, caching will be disabled
REDIS_URL="redis://localhost:6379"

# Ml service
ML_SERVICE_URL="http://ml-service:5000"

# JWT Secret - HARUS diisi dengan random string yang panjang dan unik
# Generate dengan: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN="15m"

# JWT Refresh Token - Gunakan secret yang berbeda dari JWT_SECRET
# Generate dengan: openssl rand -base64 32
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN="7d"

# Security Configuration
BCRYPT_SALT_ROUNDS=12

# Gemini AI Configuration
GEMINI_API_KEY=

# Seed Data
ADMIN_EMAIL=admin@bank.com
ADMIN_PASSWORD=Admin123!
MANAGER_EMAIL=manager@bank.com
MANAGER_PASSWORD=Manager123!
SALES_EMAIL=sales@bank.com
SALES_PASSWORD=Sales123!


CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

